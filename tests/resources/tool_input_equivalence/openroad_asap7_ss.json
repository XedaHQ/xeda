   "scripts": {
    "<RUN>/mac/yosys/yosys_synth.ys": "logger -notime\n\nlog -stdout ** Reading <DESIGN>/mac.v **\nread_verilog -defer -noautowire -sv   <DESIGN>/mac.v\n\nread_liberty -lib <RUN>/mac/openroad/merged.lib\n\nread_verilog -defer <DESIGN>/asap7/yosys/cells_clkgate_R.v\nhierarchy -check -top mac \ncheck -initdrv\n\n\nproc\nflatten\n\n\nlog -stdout Running synthesis\nsynth -flatten  -top mac\nlog -stdout Post-synth optimization\nopt -full -purge -sat\nextract_fa\ntechmap -map <DESIGN>/asap7/yosys/cells_adders_R.v\ntechmap\nopt -purge\ntechmap -map <DESIGN>/asap7/yosys/cells_latch_R.v\nlog -stdout Prepare mapping FFs to technology\ndfflibmap -prepare -liberty <DESIGN>/asap7/lib/asap7sc7p5t_SEQ_RVT_SS_nldm_220123.lib\nopt -purge\nlog -stdout Running ABC\nabc -dff -D 2000.000  -script +strash;dch;map,-B,0.9;topo;stime,-c;buffer,-c;upsize,-c;dnsize,-c -liberty <RUN>/mac/openroad/merged.lib -constr abc.constr\nopt -purge\nlog -stdout Mapping FFs to technology\ndfflibmap -liberty <DESIGN>/asap7/lib/asap7sc7p5t_SEQ_RVT_SS_nldm_220123.lib\nopt -purge\n\n# replace undefined values with 0\nsetundef -zero\nopt -full -purge\n\nopt_clean -purge\nhilomap  -singleton  -hicell TIEHIx1_ASAP7_75t_R H -locell TIELOx1_ASAP7_75t_R L\n\ninsbuf -buf BUFx2_ASAP7_75t_R A Y\n\nopt -full -purge\nclean -purge\ncheck -assert -mapped\ntee -o final_check.log check  -assert \n\nlog -stdout Writing stat to reports/utilization.json\ntee -q -o reports/utilization.json stat  -json    -liberty <RUN>/mac/openroad/merged.lib  \nsetattr -unset src =*\nsetattr -mod -unset src =*\nlog -stdout Writing netlist netlist.json\nwrite_json netlist.json\nlog -stdout Writing netlist netlist.v\nwrite_verilog -nodec -nohex -noexpr -noattr netlist.v\n\n\nlog -stdout ***** Synthesis Completed *****"
