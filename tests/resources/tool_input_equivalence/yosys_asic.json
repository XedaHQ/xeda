    "<RUN>/counter/yosys/yosys_synth.ys": "logger -notime\nread_liberty -overwrite -setattr liberty_cell -lib <WORK>/pdks/tiny/tiny.lib\n\nlog -stdout ** Reading <DESIGN>/top.v **\nread_verilog -defer -noautowire -sv   <DESIGN>/top.v\n\n\nread_verilog -defer <WORK>/pdks/tiny/cells_clkgate.v\nhierarchy -check -top top \ncheck -initdrv\nproc\nflatten\n\n\nsynth -flatten -run :fine\nsynth -top top -run fine: -noabc\nchformal -remove\ndelete t:$print\nrename -wire\nopt -purge\nextract_fa\ntechmap -map <WORK>/pdks/tiny/cells_adders.v\ntechmap\nopt -fast -purge\ndfflegalize -cell $_DLATCH_P_ x -cell $_DLATCH_N_ x t:$_DLATCH_*\ntechmap -map <WORK>/pdks/tiny/cells_latch.v\ndfflibmap -liberty <WORK>/pdks/tiny/tiny.lib -dont_use INV_X4 -dont_use NAND2_X4\nopt\nsetundef -zero\nabc -script +&get,-n;&st;&dch;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;buffer,-c;topo;stime,-c;upsize,-c;dnsize,-c -liberty <WORK>/pdks/tiny/tiny.lib -dont_use INV_X4 -dont_use NAND2_X4 -constr abc.constr\nsplitnets\nopt_clean -purge\nhilomap -singleton -hicell TIEHI_SMALL Z -locell TIELO_X1 Z\ninsbuf -buf BUF_X1 A Z\ncheck -assert -mapped\ntee -o final_check.log check  -assert \n\nlog -stdout Writing stat to reports/utilization.json\ntee -q -o reports/utilization.json stat  -json    -liberty <WORK>/pdks/tiny/tiny.lib  \nsetattr -unset src =*\nsetattr -mod -unset src =*\nlog -stdout Writing netlist netlist.json\nwrite_json netlist.json\nlog -stdout Writing netlist netlist.v\nwrite_verilog -nodec -nohex -noexpr -noattr netlist.v\n\n\nlog -stdout ***** Synthesis Completed *****"
   }
