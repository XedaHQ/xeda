   "scripts": {
    "<RUN>/counter/yosys/yosys_synth.ys": "logger -notime\n\nlog -stdout ** Reading <DESIGN>/top.v **\nread_verilog -defer -noautowire -sv   <DESIGN>/top.v\n\nread_liberty -lib merged_lib.lib\n\nread_verilog -defer <WORK>/pdks/tiny/cells_clkgate.v\nhierarchy -check -top top \ncheck -initdrv\n\n\nproc\nflatten\n\n\nlog -stdout Running synthesis\nsynth -flatten  -top top\nlog -stdout Post-synth optimization\nopt -full -purge -sat\nextract_fa\ntechmap -map <WORK>/pdks/tiny/cells_adders.v\ntechmap\nopt -purge\ntechmap -map <WORK>/pdks/tiny/cells_latch.v\nlog -stdout Prepare mapping FFs to technology\ndfflibmap -prepare -liberty merged_lib.lib\nopt -purge\nlog -stdout Running ABC\nabc -dff -D 2000.000  -script +&get,-n;&st;&dch;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;&get,-n;&st;&syn2;&if,-g,-K,6;&synch2;&nf;&put;buffer,-c;topo;stime,-c;upsize,-c;dnsize,-c -liberty merged_lib.lib -constr abc.constr\nopt -purge\nlog -stdout Mapping FFs to technology\ndfflibmap -liberty merged_lib.lib\nopt -purge\n\n# replace undefined values with 0\nsetundef -zero\nopt -full -purge\n\nopt_clean -purge\nhilomap  -singleton  -hicell TIEHI_SMALL Z -locell TIELO_X1 Z\n\ninsbuf -buf BUF_X1 A Z\n\nopt -full -purge\nclean -purge\ncheck -assert -mapped\ntee -o final_check.log check  -assert \n\nlog -stdout Writing stat to reports/utilization.json\ntee -q -o reports/utilization.json stat  -json    -liberty merged_lib.lib  \nsetattr -unset src =*\nsetattr -mod -unset src =*\nlog -stdout Writing netlist netlist.json\nwrite_json netlist.json\nlog -stdout Writing netlist netlist.v\nwrite_verilog -nodec -nohex -noexpr -noattr netlist.v\n\n\nlog -stdout ***** Synthesis Completed *****"
   }
