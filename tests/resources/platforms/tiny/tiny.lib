/* written for xeda's tests */
library (tiny) {
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  leakage_power_unit : "1nW";
  pulling_resistance_unit : "1kohm";
  capacitive_load_unit (1,ff);
  nom_voltage : 1.1;
  nom_temperature : 25;
  nom_process : 1;
  default_cell_leakage_power : 0;
  default_fanout_load : 1;
  default_max_transition : 1.0;
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  lu_table_template (delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.5");
    index_2 ("1, 50");
  }
  lu_table_template (constraint_template) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.01, 0.5");
    index_2 ("0.01, 0.5");
  }

  cell (INV_X1) {
    area : 0.840;
    pin (A) {
      direction : input;
      capacitance : 2.0;
    }
    pin (ZN) {
      direction : output;
      function : "!A";
      max_capacitance : 100;
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
    }
  }
  cell (INV_X4) {
    area : 1.680;
    dont_use : true;
    pin (A) {
      direction : input;
      capacitance : 2.0;
    }
    pin (ZN) {
      direction : output;
      function : "!A";
      max_capacitance : 100;
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
    }
  }
  cell (BUF_X1) {
    area : 1.120;
    pin (A) {
      direction : input;
      capacitance : 2.0;
    }
    pin (Z) {
      direction : output;
      function : "A";
      max_capacitance : 100;
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
    }
  }
  cell (NAND2_X1) {
    area : 1.120;
    pin (A1) {
      direction : input;
      capacitance : 2.0;
    }
    pin (A2) {
      direction : input;
      capacitance : 2.0;
    }
    pin (ZN) {
      direction : output;
      function : "!(A1&A2)";
      max_capacitance : 100;
      timing () {
        related_pin : "A1";
        timing_sense : negative_unate;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
      timing () {
        related_pin : "A2";
        timing_sense : negative_unate;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
    }
  }
  cell (NAND2_X4) {
    area : 2.240;
    dont_use : true;
    pin (A1) {
      direction : input;
      capacitance : 2.0;
    }
    pin (A2) {
      direction : input;
      capacitance : 2.0;
    }
    pin (ZN) {
      direction : output;
      function : "!(A1&A2)";
      max_capacitance : 100;
      timing () {
        related_pin : "A1";
        timing_sense : negative_unate;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
      timing () {
        related_pin : "A2";
        timing_sense : negative_unate;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
    }
  }
  cell (NOR2_X1) {
    area : 1.120;
    pin (A1) {
      direction : input;
      capacitance : 2.0;
    }
    pin (A2) {
      direction : input;
      capacitance : 2.0;
    }
    pin (ZN) {
      direction : output;
      function : "!(A1|A2)";
      max_capacitance : 100;
      timing () {
        related_pin : "A1";
        timing_sense : negative_unate;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
      timing () {
        related_pin : "A2";
        timing_sense : negative_unate;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
    }
  }
  cell (DFF_X1) {
    area : 3.360;
    ff (IQ, IQN) {
      next_state : "D";
      clocked_on : "CK";
    }
    pin (D) {
      direction : input;
      capacitance : 2.0;
      timing () {
        related_pin : "CK";
        timing_type : setup_rising;
        rise_constraint (constraint_template) {
          values ( \
            "0.05, 0.05", \
            "0.05, 0.05" \
          );
        }
        fall_constraint (constraint_template) {
          values ( \
            "0.05, 0.05", \
            "0.05, 0.05" \
          );
        }
      }
      timing () {
        related_pin : "CK";
        timing_type : hold_rising;
        rise_constraint (constraint_template) {
          values ( \
            "0.02, 0.02", \
            "0.02, 0.02" \
          );
        }
        fall_constraint (constraint_template) {
          values ( \
            "0.02, 0.02", \
            "0.02, 0.02" \
          );
        }
      }
    }
    pin (CK) {
      direction : input;
      capacitance : 2.0;
      clock : true;
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      max_capacitance : 100;
      timing () {
        related_pin : "CK";
        timing_type : rising_edge;
        cell_rise (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        cell_fall (delay_template) {
          values ( \
            "0.05, 0.2", \
            "0.1, 0.4" \
          );
        }
        rise_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
        fall_transition (delay_template) {
          values ( \
            "0.03, 0.15", \
            "0.06, 0.3" \
          );
        }
      }
    }
  }
  cell (TIEHI_BIG) {
    area : 1.680;
    pin (Z) {
      direction : output;
      function : "1";
      max_capacitance : 100;
    }
  }
  cell (TIEHI_SMALL) {
    area : 1.120;
    pin (Z) {
      direction : output;
      function : "1";
      max_capacitance : 100;
    }
  }
  cell (TIELO_X1) {
    area : 1.120;
    pin (Z) {
      direction : output;
      function : "0";
      max_capacitance : 100;
    }
  }
}
