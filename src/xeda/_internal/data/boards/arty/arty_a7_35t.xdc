## ChipKit Outer Analog Header - as Single-Ended Analog Inputs
## NOTE: These ports can be used as single-ended analog inputs with voltages from 0-3.3V (ChipKit analog pins A0-A5) or as digital I/O.
## WARNING: Do not use both sets of constraints at the same time!
## NOTE: The following constraints should be used with the XADC IP core when using these ports as analog inputs.
set_property PACKAGE_PIN C5 [get_ports {vaux4_n}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux4_n}]
set_property PACKAGE_PIN C6 [get_ports {vaux4_p}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux4_p}]
set_property PACKAGE_PIN A5 [get_ports {vaux5_n}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux5_n}]
set_property PACKAGE_PIN A6 [get_ports {vaux5_p}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux5_p}]
set_property PACKAGE_PIN B4 [get_ports {vaux6_n}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux6_n}]
set_property PACKAGE_PIN C4 [get_ports {vaux6_p}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux6_p}]
set_property PACKAGE_PIN A1 [get_ports {vaux7_n}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux7_n}]
set_property PACKAGE_PIN B1 [get_ports {vaux7_p}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux7_p}]
set_property PACKAGE_PIN B2 [get_ports {vaux15_n}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux15_n}]
set_property PACKAGE_PIN B3 [get_ports {vaux15_p}]
set_property IOSTANDARD LVCMOS33 [get_ports {vaux15_p}]
