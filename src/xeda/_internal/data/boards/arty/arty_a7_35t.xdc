# Digilent Arty A7-35, Rev. D/E: active pin-only derivative.
# Source: https://github.com/Digilent/digilent-xdc/blob/00a3404901f35aa9567b01ecb3f2c233b6efe9f4/Arty-A7-35-Master.xdc
# Copyright (c) 2017 Digilent. MIT license; see LICENSE.md.
# Keep the Digilent port names in the design. Timing comes from flow clocks.

## This file is a general .xdc for the Arty A7-35 Rev. D and Rev. E
## To use it in a project:
## - uncomment the lines corresponding to used pins
## - rename the used ports (in each line, after get_ports) according to the top level signal names in the project
## Clock signal
set_property PACKAGE_PIN E3 [get_ports {CLK100MHZ}]
set_property IOSTANDARD LVCMOS33 [get_ports {CLK100MHZ}]
## Switches
set_property PACKAGE_PIN A8 [get_ports {sw[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw[0]}]
set_property PACKAGE_PIN C11 [get_ports {sw[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw[1]}]
set_property PACKAGE_PIN C10 [get_ports {sw[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw[2]}]
set_property PACKAGE_PIN A10 [get_ports {sw[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw[3]}]
## RGB LEDs
set_property PACKAGE_PIN E1 [get_ports {led0_b}]
set_property IOSTANDARD LVCMOS33 [get_ports {led0_b}]
set_property PACKAGE_PIN F6 [get_ports {led0_g}]
set_property IOSTANDARD LVCMOS33 [get_ports {led0_g}]
set_property PACKAGE_PIN G6 [get_ports {led0_r}]
set_property IOSTANDARD LVCMOS33 [get_ports {led0_r}]
set_property PACKAGE_PIN G4 [get_ports {led1_b}]
set_property IOSTANDARD LVCMOS33 [get_ports {led1_b}]
set_property PACKAGE_PIN J4 [get_ports {led1_g}]
set_property IOSTANDARD LVCMOS33 [get_ports {led1_g}]
set_property PACKAGE_PIN G3 [get_ports {led1_r}]
set_property IOSTANDARD LVCMOS33 [get_ports {led1_r}]
set_property PACKAGE_PIN H4 [get_ports {led2_b}]
set_property IOSTANDARD LVCMOS33 [get_ports {led2_b}]
set_property PACKAGE_PIN J2 [get_ports {led2_g}]
set_property IOSTANDARD LVCMOS33 [get_ports {led2_g}]
set_property PACKAGE_PIN J3 [get_ports {led2_r}]
set_property IOSTANDARD LVCMOS33 [get_ports {led2_r}]
set_property PACKAGE_PIN K2 [get_ports {led3_b}]
set_property IOSTANDARD LVCMOS33 [get_ports {led3_b}]
set_property PACKAGE_PIN H6 [get_ports {led3_g}]
set_property IOSTANDARD LVCMOS33 [get_ports {led3_g}]
set_property PACKAGE_PIN K1 [get_ports {led3_r}]
set_property IOSTANDARD LVCMOS33 [get_ports {led3_r}]
