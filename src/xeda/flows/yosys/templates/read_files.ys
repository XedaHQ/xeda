{% if settings.debug or settings.verbose > 1 -%}
echo on
{% endif -%}

{% set include_tb = read_tb_sources|default(false) -%}
{% set sources = sources_read(rtl=true, tb=include_tb) -%}
{% set top = hierarchy_top|default(design.rtl.top) -%}
{% set vhdl_top = ghdl_top|default(design.rtl.top) -%}
{% set include_dirs=namespace(i=[]) %}
{% for src in sources if src.type is not none and src.type.name in ("VerilogHeader", "SVHeader") -%}
{% set flag = "-I" ~ (src.path.parent|verbatim_path) -%}
{% if flag not in include_dirs.i -%}{% set include_dirs.i = include_dirs.i + [flag] %}{% endif -%}
{% endfor -%}

{% for plugin in settings.plugins -%}
plugin -i {{plugin|verbatim_path}}
{% endfor -%}

{% set sv_files = sources|selectattr("type.name", "equalto", "SystemVerilog")|list -%}
{% set uhdm_plugin = (settings.systemverilog == "uhdm") and sv_files -%}
{% if uhdm_plugin and "systemverilog" not in settings.plugins -%}
plugin -i systemverilog
{% endif -%}
{% set slang_plugin = (settings.systemverilog == "slang") and sv_files -%}
{% if slang_plugin and settings.use_slang_plugin and "slang" not in settings.plugins -%}
plugin -i slang
{% endif -%}

{% for lib in primitive_libraries|default([]) -%}
read_verilog {{lib.flags|join(" ")}} {{lib.path|read_path}}
{% endfor -%}

{% for src in sources -%}
{% if src.type is not none -%}
    {% if src.type.name == "Verilog" -%}
log -stdout ** Reading {{src}} **
read_verilog -defer {{settings.read_verilog_flags|join(" ")}} {{defines|join(" ")}} {{include_dirs.i|join(" ")}} {{src|read_path}}
    {% elif src.type.name == "SystemVerilog" %}
log -stdout ** Reading {{src}} **
        {#- plugin frontends (slang/uhdm) do not strip quotes: `verbatim_path` #}
        {%- if slang_plugin %}
read_slang --extern-modules --best-effort-hierarchy {{defines|join(" ")}} {{include_dirs.i|join(" ")}} {{src|verbatim_path}}
        {%- elif uhdm_plugin %}
read_systemverilog -defer {{settings.read_systemverilog_flags|join(" ")}} {{src|verbatim_path}}
        {%- else %}
read_verilog -sv -defer {{settings.read_verilog_flags|join(" ")}} {{defines|join(" ")}} {{include_dirs.i|join(" ")}} {{src|read_path}}
        {%- endif %}
    {% endif -%}
{% endif -%}
{% endfor -%}

{#- NOTE: unlike yosys' own frontends, the ghdl plugin does not strip surrounding
    double quotes, and yosys' script tokenizer leaves that to each command, so
    its arguments go through `ghdl_arg`/`verbatim_path`. #}
{% set vhdl_files = sources|selectattr("type.name", "equalto", "Vhdl")|list -%}
{% if vhdl_files -%}
log -stdout ** Elaborating VHDL files **
plugin -i ghdl
ghdl {{ghdl_args|map("ghdl_arg")|join(" ")}} {{vhdl_files|map("verbatim_path")|join(" ")}} -e {% if vhdl_top -%} {{vhdl_top}} {%- endif %}
{% endif -%}

{% if settings.liberty is defined -%}
{% for lib in settings.liberty -%}
read_liberty -lib {{lib|read_path}}
{% endfor -%}
{% endif -%}

{#- `yosys_fpga` passes `verilog_libs`: `verilog_lib` without the entries that are a library the
    target's pass reads itself, which it decides by the file each one is
    (`YosysFpga.verilog_libraries_to_read`), whatever this script reads. Every other flow
    reads its `verilog_lib` as given. -#}
{% for src in verilog_libs|default(settings.verilog_lib) -%}
read_verilog -lib {{src|read_path}}
{% endfor -%}

{#- a VHDL top got its generics from GHDL, and has no parameters left #}
{% if not top_is_vhdl() -%}
{% for key, value in parameters.items() -%}
chparam -set {{key}} {{value|esc}} {% if design.rtl.top -%} {{design.rtl.top}} {%- endif %}
{% endfor -%}
{% endif -%}

{% if settings.clockgate_map is defined and settings.clockgate_map -%}
read_verilog -defer {{settings.clockgate_map|read_path}}
{% endif -%}

{% if uhdm_plugin -%}
read_systemverilog -link
{% endif -%}
{#- `synth_pass_only` (yosys_fpga) leaves the hierarchy and the checks to the synthesis pass,
    which runs `hierarchy -check` in its own `begin` step. Every other flow including this
    template passes nothing, so `default(false)` keeps their scripts as they are. -#}
{% if not synth_pass_only|default(false) -%}
hierarchy -check {% if top -%} -top {{top}} {% else %} -auto-top {%- endif %}
{% endif -%}
{% for mod in settings.black_box -%}
log -stdout Converting module {{mod}} into blackbox
blackbox {{mod}}
{% endfor -%}

{% for attr, value in settings.set_attribute.items() -%}
{% if value is mapping -%}
{% for path, v in value.items() -%}
setattr -set {{attr}} {{v|esc}} {{path}}
{% endfor -%}
{% else %}
setattr -set {{attr}} {{value|esc}}
{% endif -%}
{% endfor -%}
{% for attr, value in settings.set_mod_attribute.items() -%}
{% for path, v in value.items() -%}
setattr -mod -set {{attr}} {{v|esc}} {{path}}
{% endfor -%}
{% endfor -%}

{% if not synth_pass_only|default(false) -%}
check -initdrv
{%- endif %}
