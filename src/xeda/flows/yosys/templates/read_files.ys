{% if settings.debug or settings.verbose > 1 -%}
echo on
{% endif -%}

{% set include_tb = read_tb_sources|default(false) -%}
{% set sources = sources_read(rtl=true, tb=include_tb) -%}
{% set top = hierarchy_top|default(design.rtl.top) -%}
{% set vhdl_top = ghdl_top|default(design.rtl.top) -%}
{% set include_dirs=namespace(i=[]) %}
{% for src in sources if src.type is not none and src.type.name in ("VerilogHeader", "SVHeader") -%}
{% set flag = "-I" ~ (src.path.parent|verbatim_path) -%}
{% if flag not in include_dirs.i -%}{% set include_dirs.i = include_dirs.i + [flag] %}{% endif -%}
{% endfor -%}

{% for plugin in settings.plugins -%}
plugin -i {{plugin|verbatim_path}}
{% endfor -%}

{% set sv_files = sources|selectattr("type.name", "equalto", "SystemVerilog")|list -%}
{% set uhdm_plugin = (settings.systemverilog == "uhdm") and sv_files -%}
{% if uhdm_plugin and "systemverilog" not in settings.plugins -%}
plugin -i systemverilog
{% endif -%}
{% set slang_plugin = (settings.systemverilog == "slang") and sv_files -%}
{#- With slang, one `read_slang` reads the Verilog sources too, and `read_slang -G` sets the
    parameters of the top module while it elaborates, as OpenROAD-flow-scripts does. `chparam`
    cannot change a module that slang elaborated. -#}
{% set slang_params = slang_plugin and not top_is_vhdl() -%}
{% set slang_files = sources|selectattr("type.name", "in", ("Verilog", "SystemVerilog"))|list if slang_plugin else [] -%}
{% if slang_plugin and settings.use_slang_plugin and "slang" not in settings.plugins -%}
plugin -i slang
{% endif -%}

{#- With slang, a library that the sources instantiate (`liberty`, `verilog_lib`) is read before
    them: slang resolves every instance when it reads the sources. -#}
{%- macro read_libraries() -%}
{#- The mapping to a standard cell library sets `liberty_read`: it has read its Liberty files
    before the sources, with the attribute that marks library cells. -#}
{% if settings.liberty is defined and not liberty_read|default(false) -%}
{% for lib in settings.liberty -%}
read_liberty -lib {{lib|read_path}}
{% endfor -%}
{% endif -%}

{#- `yosys_fpga` passes `verilog_libs`: `verilog_lib` without the entries that are a library the
    synthesis pass reads itself. It decides by the file that each entry names
    (`YosysFpga.verilog_libraries_to_read`), whatever this script reads. Every other flow reads
    its `verilog_lib` as given. -#}
{% for src in verilog_libs|default(settings.verilog_lib) -%}
read_verilog -lib {{src|read_path}}
{% endfor -%}
{%- endmacro -%}
{% for lib in primitive_libraries|default([]) -%}
read_verilog {{lib.flags|join(" ")}} {{lib.path|read_path}}
{% endfor -%}

{% if slang_plugin -%}
{{ read_libraries() }}
{%- endif -%}

{% for src in sources -%}
{% if src.type is not none -%}
    {% if slang_plugin and src.type.name in ("Verilog", "SystemVerilog") %}
        {#- the slang front end does not strip quotes, so use `verbatim_path`. slang elaborates
            what one `read_slang` reads as one compilation, so the first Verilog or SystemVerilog
            source reads them all: a package of one file is then known in the others, as in
            OpenROAD-flow-scripts. #}
        {%- if src is sameas slang_files[0] %}
            {%- for sv in slang_files %}
log -stdout ** Reading {{sv}} **
            {%- endfor %}
read_slang --extern-modules --best-effort-hierarchy{% if settings.read_systemverilog_flags %} {{settings.read_systemverilog_flags|join(" ")}}{% endif %} {{defines|join(" ")}} {{include_dirs.i|join(" ")}} {{slang_files|map("verbatim_path")|join(" ")}}{% if slang_params %}{% for key, value in parameters.items() %} -G {{key}}={{value|esc}}{% endfor %}{% endif %}
        {%- endif %}
    {% elif src.type.name == "Verilog" -%}
log -stdout ** Reading {{src}} **
read_verilog -defer {{settings.read_verilog_flags|join(" ")}} {{defines|join(" ")}} {{include_dirs.i|join(" ")}} {{src|read_path}}
    {% elif src.type.name == "SystemVerilog" %}
        {%- if uhdm_plugin %}
log -stdout ** Reading {{src}} **
read_systemverilog -defer {{settings.read_systemverilog_flags|join(" ")}} {{src|verbatim_path}}
        {%- else %}
log -stdout ** Reading {{src}} **
read_verilog -sv -defer {{settings.read_verilog_flags|join(" ")}} {{defines|join(" ")}} {{include_dirs.i|join(" ")}} {{src|read_path}}
        {%- endif %}
    {% endif -%}
{% endif -%}
{% endfor -%}

{#- Unlike the front ends of yosys itself, the ghdl plugin does not strip surrounding double
    quotes, and the script tokenizer of yosys leaves that to each command. So the arguments of
    the plugin go through `ghdl_arg` and `verbatim_path`. #}
{% set vhdl_files = sources|selectattr("type.name", "equalto", "Vhdl")|list -%}
{% if vhdl_files -%}
log -stdout ** Elaborating VHDL files **
plugin -i ghdl
ghdl {{ghdl_args|map("ghdl_arg")|join(" ")}} {{vhdl_files|map("verbatim_path")|join(" ")}} -e {% if vhdl_top -%} {{vhdl_top}} {%- endif %}
{% endif -%}

{% if not slang_plugin -%}
{{ read_libraries() }}
{%- endif -%}

{#- a VHDL top module got its generics from GHDL and has no parameters left, and slang
    got the parameters in its `read_slang` #}
{% if not top_is_vhdl() and not slang_params -%}
{% for key, value in parameters.items() -%}
chparam -set {{key}} {{value|esc}} {% if design.rtl.top -%} {{design.rtl.top}} {%- endif %}
{% endfor -%}
{% endif -%}

{% if clockgate_map is defined and clockgate_map -%}
read_verilog -defer {{clockgate_map|read_path}}
{% endif -%}

{% if uhdm_plugin -%}
read_systemverilog -link
{% endif -%}
{#- `synth_pass_only` (yosys_fpga) leaves the hierarchy and the checks to the synthesis pass,
    which runs `hierarchy -check` in its own `begin` step. Every other flow that includes this
    template passes nothing, so `default(false)` keeps their scripts unchanged. -#}
{% if not synth_pass_only|default(false) -%}
hierarchy -check {% if top -%} -top {{top}} {% else %} -auto-top {%- endif %}
{% endif -%}
{% for mod in settings.black_box -%}
log -stdout Converting module {{mod}} into blackbox
blackbox {{mod}}
{% endfor -%}

{% for attr, value in settings.set_attribute.items() -%}
{% if value is mapping -%}
{% for path, v in value.items() -%}
setattr -set {{attr}} {{v|esc}} {{path}}
{% endfor -%}
{% else %}
setattr -set {{attr}} {{value|esc}}
{% endif -%}
{% endfor -%}
{% for attr, value in settings.set_mod_attribute.items() -%}
{% for path, v in value.items() -%}
setattr -mod -set {{attr}} {{v|esc}} {{path}}
{% endfor -%}
{% endfor -%}

{% if not synth_pass_only|default(false) -%}
check -initdrv
{%- endif %}
