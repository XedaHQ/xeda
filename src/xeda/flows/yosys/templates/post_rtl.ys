{%- if settings.rtl_json %}
log -stdout Writing JSON {{settings.rtl_json}}
write_json {{settings.rtl_json}}
{%- endif %}
{%- if settings.rtl_verilog %}
log -stdout Writing Verilog {{settings.rtl_verilog}}
write_verilog {{settings.rtl_verilog}}
{%- endif %}
{%- if settings.rtl_graph %}
log -stdout Writing RTL graph to {{settings.rtl_graph.with_suffix('dot')}}
show -prefix {{settings.rtl_graph.with_suffix("")}} -format dot {{settings.rtl_graph_flags|join(" ")}}
{%- endif %}
{#- yosys scripts have no `exit` command: `stop_after == "rtl"` is handled by the
    including template, which simply does not emit the post-RTL commands. #}
