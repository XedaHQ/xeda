{# The driver of the first process of openroad: it reads the database of the global route and its
   SDC file, routes the design in detail, repairs the antenna violations and places the filler
   cells. The decap cells of the settings go in between, since the filler cells fill what they
   leave. The database and the SDC file of the result are working files of the flow: the process
   after this one reads them. A stage that fails leaves the database of that moment in the failed
   database, and the error ends the process. #}
{% set restart = "database" %}
{% set sdc_files = [inputs.sdc] %}
{% include "restart.tcl.j2" %}
{% include "procs.tcl.j2" %}
{% include "stages/detail_route.tcl.j2" %}
{% if P.decap_net %}
{% include "stages/ir_setup.tcl.j2" %}
{% include "stages/ir_decap.tcl.j2" %}
{% endif %}
{% include "stages/fillcell.tcl.j2" %}
if {[catch {
    xeda_detail_route
{% if P.decap_net %}
    xeda_ir_decap
{% endif %}
    xeda_fillcell
} message options]} {
    catch { write_db {{ failed_odb|tcl_word }} }
    return -options $options $message
}
write_db {{ working_files.odb|tcl_word }}
write_sdc -no_timestamp {{ working_files.sdc|tcl_word }}
