{# The tap cells and the end caps. `tapcell` places both. `cut_rows` cuts the rows around the
   obstructions and places the end caps only. #}
proc xeda_tapcell {} {
    xeda_stage tapcell
{% if P.tapcell_mode == "tap_endcap" %}
    tapcell -distance {{ P.tap_distance|tcl_number }} -tapcell_master {{ P.tap_master|tcl_word }}{{ " -endcap_master " ~ (P.endcap_master|tcl_word) if P.endcap_master else "" }}
{% elif P.tapcell_mode == "cut_rows" %}
    cut_rows{{ " -endcap_master " ~ (P.endcap_master|tcl_word) if P.endcap_master else "" }}
{% endif %}
}
